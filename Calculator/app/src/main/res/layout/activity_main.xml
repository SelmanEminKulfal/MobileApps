<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Sonuç Gösterme Alanı -->
        <EditText
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="end"
            android:textSize="24sp"
            android:background="@android:color/darker_gray"
            android:padding="10dp"
            android:inputType="none"
            android:focusable="false"/>

        <!-- Grid Layout Kullanarak 4x5 Matris -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="5"
            android:layout_marginTop="16dp">

            <!-- Butonlar -->
            <Button android:text="7" style="@style/NumberButton"/>
            <Button android:text="8" style="@style/NumberButton"/>
            <Button android:text="9" style="@style/NumberButton"/>
            <Button android:text="+" style="@style/OperatorButton"/>
            <Button android:text="4" style="@style/NumberButton"/>
            <Button android:text="5" style="@style/NumberButton"/>
            <Button android:text="6" style="@style/NumberButton"/>
            <Button android:text="-" style="@style/OperatorButton"/>
            <Button android:text="3" style="@style/NumberButton"/>
            <Button android:text="2" style="@style/NumberButton"/>
            <Button android:text="1" style="@style/NumberButton"/>
            <Button android:text="*" style="@style/OperatorButton"/>
            <Button android:text="x^y" style="@style/OperatorButton"/>
            <Button android:text="0" style="@style/NumberButton"/>
            <Button android:text="." style="@style/OperatorButton"/>
            <Button android:text="/" style="@style/OperatorButton"/>
            <Button android:text="√" style="@style/OperatorButton"/>
            <Button android:text="n!" style="@style/OperatorButton"/>
            <Button android:text="=" style="@style/OperatorButton"/>
            <Button android:text="C" style="@style/OperatorButton"/>


        </GridLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>