<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Sonuç Gösterme Alanı -->
        <EditText
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="end"
            android:textSize="24sp"
            android:background="@android:color/darker_gray"
            android:padding="10dp"
            android:inputType="none"
            android:focusable="false"/>

        <!-- Grid Layout Kullanarak 4x5 Matris -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="5"
            android:layout_marginTop="16dp">

            <!-- Butonlar -->
            <Button android:text="7" android:id="@+id/btn_7" style="@style/NumberButton"/>
            <Button android:text="8" android:id="@+id/btn_8" style="@style/NumberButton"/>
            <Button android:text="9" android:id="@+id/btn_9" style="@style/NumberButton"/>
            <Button android:text="+" android:id="@+id/btn_sum" style="@style/OperatorButton"/>
            <Button android:text="4" android:id="@+id/btn_4" style="@style/NumberButton"/>
            <Button android:text="5" android:id="@+id/btn_5" style="@style/NumberButton"/>
            <Button android:text="6" android:id="@+id/btn_6" style="@style/NumberButton"/>
            <Button android:text="-" android:id="@+id/btn_minus" style="@style/OperatorButton"/>
            <Button android:text="3" android:id="@+id/btn_3" style="@style/NumberButton"/>
            <Button android:text="2" android:id="@+id/btn_2" style="@style/NumberButton"/>
            <Button android:text="1" android:id="@+id/btn_1" style="@style/NumberButton"/>
            <Button android:text="*" android:id="@+id/btn_mult" style="@style/OperatorButton"/>
            <Button android:text="x^y" android:id="@+id/btn_power" style="@style/OperatorButton"/>
            <Button android:text="0" android:id="@+id/btn_0" style="@style/NumberButton"/>
            <Button android:text="." android:id="@+id/btn_dot" style="@style/OperatorButton"/>
            <Button android:text="/" android:id="@+id/btn_div" style="@style/OperatorButton"/>
            <Button android:text="√" android:id="@+id/btn_sqrt" style="@style/OperatorButton"/>
            <Button android:text="n!" android:id="@+id/btn_fact" style="@style/OperatorButton"/>
            <Button android:text="=" android:id="@+id/btn_equal" style="@style/OperatorButton"/>
            <Button android:text="C" android:id="@+id/btn_clean" style="@style/OperatorButton"/>



        </GridLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>